{
  "name": "scode",
  "version": "0.1.0",
  "description": "Local-first quota-aware router for coding agent CLIs",
  "type": "module",
  "bin": {
    "jcode": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sivab193/scode.git"
  },
  "bugs": {
    "url": "https://github.com/sivab193/scode/issues"
  },
  "homepage": "https://github.com/sivab193/scode#readme",
  "author": "Sivaganesh Balaganesh",
  "keywords": [
    "cli",
    "router",
    "coding-agent",
    "codex",
    "claude-code",
    "copilot",
    "opencode",
    "kiro",
    "quota",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cron-parser": "^5.10.6",
    "ink": "^6.3.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
