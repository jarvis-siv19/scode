{
  "name": "jcode",
  "version": "0.1.0",
  "description": "Local-first quota-aware router for coding agent CLIs",
  "type": "module",
  "bin": {
    "jcode": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^6.3.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
